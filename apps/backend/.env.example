# =============================================
# Backend - Local Development Environment
# =============================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env

# Database (docker-compose PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/video_processor"

# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Authentication (空 = 認証無効。ローカル開発用)
# WEBAPP_API_KEY=

# Storage: ローカルファイルシステムを使用 (GCSの代わり)
TEMP_STORAGE_TYPE=local
LOCAL_TEMP_STORAGE_DIR=/tmp/video-processor-cache
BACKEND_URL=http://localhost:8080

# AI Keys (AI機能を使う場合に設定)
# ANTHROPIC_API_KEY=sk-ant-your-key
# GEMINI_API_KEY=your-key
# OPENAI_API_KEY=sk-proj-your-key

# Google Cloud (ローカル開発ではlocal storageを使うため不要)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_CLOUD_PROJECT=

# Fish Audio TTS (ショート動画の音声生成に使用。基本テストでは不要)
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_DEFAULT_VOICE_MODEL_ID=

# Google Drive (基本テストでは不要)
# GOOGLE_DRIVE_OUTPUT_FOLDER_ID=
# TRANSCRIPT_OUTPUT_FOLDER_ID=
